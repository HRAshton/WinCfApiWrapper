            Include="Microsoft.Extensions.DependencyInjection.Abstractions"
            Version="10.0.14"
        />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.367" />
        <PackageVersion Include="StyleCop.Analyzers" Version="1.3.98-beta" />
        <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    </ItemGroup>
</Project>
