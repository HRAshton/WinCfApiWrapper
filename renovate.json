{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Belgrade",
  "schedule": [
    "* * * * 1"
  ],
  "updateNotScheduled": false,
  "semanticCommits": "enabled",
  "commitMessageLowerCase": "never",
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "One Monday PR for every non-major (minor or patch) update",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "weekly non-major dependencies",
      "groupSlug": "weekly-non-major",
      "automerge": true
    },
    {
      "description": "Major dependency upgrades require maintainer review; no automerge",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Automerge pinned and updated dependency digests after CI",
      "matchUpdateTypes": [
        "pinDigest",
        "digest"
      ],
      "automerge": true
    }
  ]
}
